# Sphinx help build artifacts (keep only compiled offline HTML)
help/html/.doctrees/
help/html/_static/fonts/
help/html/_static/css/fonts/

# Packaging files and dependencies (only minimal needed)
uv.lock
Makefile
Dockerfile
.dockerignore
docker-compose.yml
run_qgis_manage.py
