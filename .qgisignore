# .qgisignore
# This file defines the patterns for files and directories that should be
# ignored when packaging or deploying the QGIS plugin.
# Its purpose is to prevent development artifacts (such as tests, virtual
# environments, caches, and AI/Agent metadata) from being included
# in the redistributable package (.zip).

# Version control and IDE configurations
.git
.gitignore
.qgisignore
.gitattributes
.github
.idea
.vscode
.devcontainer
.editorconfig
.pyre_configuration
.python-version
pyproject.toml
pyrightconfig.json
requirements.txt

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# AI, Agents, and Contexts
.agent/
.gemini-temp/
.ai-context/
.codewhale/
.continue/
.deepseek/
.ai_context_cache.json
AGENTS.md
AI_CONTEXT.md
PROJECT_SUMMARY.md
antigravity-framerepo/
project_context.json
ARCHITECTURE.mmd
skills-lock.json

