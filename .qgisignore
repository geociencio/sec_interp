gui_coverage_final.txt
gui_coverage_report.txt
missing_tests.txt
test_coverage_analysis.txt
.ai_context_cache.json
.coverage
python_test.log
docker_test.log

# Documentation, Scripts, and Development Examples
docs/
/examples/
/scripts/
/tools/
README_DEV.md
core_files.txt
test_files.txt
