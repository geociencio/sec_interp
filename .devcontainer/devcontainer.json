{
    "name": "SecInterp Dev Env",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ]
        }
    },
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}/..:${containerWorkspaceFolder}"
    },
    "remoteUser": "root"
}