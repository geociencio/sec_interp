#: ../../source/DEVELOPMENT_GUIDE.md:167
msgid "📦 Deployment & Makefile"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:169
msgid "Use the `Makefile` for common development tasks:"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:171
msgid "`make deploy`: Installs the plugin into your local QGIS plugins folder."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:172
msgid "`make zip`: Creates a release-ready ZIP file."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:173
msgid "`make test`: Runs all unit and integration tests locally."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:174
msgid "`make docker-build`: Builds the testing Docker image."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:175
msgid "`make docker-test`: Builds and runs tests within a QGIS Docker container."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:176
msgid "`make docus`: Builds the Sphinx documentation."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:177
msgid "`make clean`: Removes temporary and compiled files."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:178
msgid ""
"`make transup`: Updates `.ts` files and applies master data using "
"`apply_full.py`."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:179
msgid "`make transcompile`: Compiles `.qm` files."
msgstr ""

