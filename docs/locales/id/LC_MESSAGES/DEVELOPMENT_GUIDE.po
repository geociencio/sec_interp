msgid "🧪 Testing"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:86
msgid "Running Tests (Local)"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:92
msgid "Running Tests (Docker - Recommended)"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:93
msgid "To avoid dependency issues with QGIS, use the containerized environment:"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:99
msgid "Mocking QGIS"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:100
msgid ""
"When testing core services, use `unittest.mock` to avoid requiring a "
"running QGIS instance. For integration tests in a headless environment, "
"the project is configured to use `QT_QPA_PLATFORM=offscreen`."
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:104
msgid "📝 Documentation Standards"
msgstr ""

#: ../../source/DEVELOPMENT_GUIDE.md:106
