#: of sec_interp.gui.tools.measure_tool:1
msgid "Measurement tool for Profile View."
msgstr ""

#: of sec_interp.gui.tools.measure_tool:3
msgid ""
"This module provides the ProfileMeasureTool for measuring distances, "
"elevation differences, and slopes in the profile preview window. It "
"separates UI event handling from spatial snapping logic."
msgstr ""

#: of sec_interp.gui.tools.measure_tool.ProfileMeasureTool:1
msgid "Map tool for measuring distances in profile view."
msgstr ""

#: of sec_interp.gui.tools.measure_tool.ProfileMeasureTool:3
msgid ""
"Supports multi-point polyline measurements: - Click to add points along "
"the trace - Click \"Finalizar\" button in UI to complete measurement - "
"Right-click or Escape to cancel and reset"
msgstr ""

