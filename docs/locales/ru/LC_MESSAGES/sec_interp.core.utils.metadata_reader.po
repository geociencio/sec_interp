#: of sec_interp.core.utils.metadata_reader.read_plugin_metadata:1
msgid "Read plugin metadata from metadata.txt."
msgstr ""

#: of sec_interp.core.utils.metadata_reader.read_plugin_metadata:3
msgid ""
"Reads the standard QGIS metadata.txt file and extracts key information "
"about the plugin. Results are cached to avoid repeated file I/O."
msgstr ""

