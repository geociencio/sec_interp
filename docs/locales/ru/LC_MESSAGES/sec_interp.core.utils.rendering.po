#: of sec_interp.core.utils.rendering.calculate_bounds:1
msgid "Calculate the bounding box for all profile data with padding."
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_bounds:3
msgid ""
"Calculates the minimum and maximum distance and elevation across "
"topography and optional geological segments."
msgstr ""

#: ../../../source/sec_interp.core.utils.rendering.rst
msgid "Parameters"
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_bounds:6
msgid "List of (distance, elevation) tuples for topography."
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_bounds:7
msgid "Optional list of geological segments."
msgstr ""

#: ../../../source/sec_interp.core.utils.rendering.rst
msgid "Returns"
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_bounds:9
msgid "Bounds containing 'min_d', 'max_d', 'min_e', 'max_e' with 5% padding."
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_interval:1
msgid "Calculate a 'nice' interval for axis labels based on the data range."
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_interval:3
msgid "The total range of data values (e.g., max_d - min_d)."
msgstr ""

#: of sec_interp.core.utils.rendering.calculate_interval:5
msgid "A human-readable interval (e.g., 1, 2, 5, 10, etc.) for grid lines."
msgstr ""

