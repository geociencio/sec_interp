#: of sec_interp.core.utils.geology.calculate_apparent_dip:1
msgid "Convert true dip to apparent dip in section plane."
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:3
msgid ""
"The apparent dip is the inclination of a plane measured in a direction "
"not perpendicular to the strike. In a vertical cross-section, the "
"apparent dip depends on the angle between the strike of the plane and the"
" azimuth of the cross-section line."
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:8
msgid "Formula:"
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:9
msgid "tan(apparent_dip) = tan(true_dip) * sin(alpha)"
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:11
msgid ""
"Where alpha is the angle between the strike of the plane and the "
"direction of the cross-section (section azimuth). alpha = strike - "
"section_azimuth"
msgstr ""

#: ../../../source/sec_interp.core.utils.geology.rst
msgid "Parameters"
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:15
msgid "Strike of the geological plane (0-360 degrees)."
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:16
msgid "True dip of the geological plane (0-90 degrees)."
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:17
msgid "Azimuth of the cross-section line (0-360 degrees)."
msgstr ""

#: ../../../source/sec_interp.core.utils.geology.rst
msgid "Returns"
msgstr ""

#: of sec_interp.core.utils.geology.calculate_apparent_dip:19
msgid ""
"Apparent dip in degrees. Positive values indicate dip, negative values "
"might occur depending on quadrant but are typically normalized."
msgstr ""
