msgstr ""

#: ../../../source/USER_GUIDE.md:104
msgid "3. Intervals Tab"
msgstr ""

#: ../../../source/USER_GUIDE.md:105
msgid "Configures geological or attribute intervals."
msgstr ""

#: ../../../source/USER_GUIDE.md:106
msgid "**Interval Layer**: Table or layer with logging data (optional)."
msgstr ""

#: ../../../source/USER_GUIDE.md:107
msgid ""
"**Hole ID**: Field linking to the Collar ID (Mandatory if Interval Layer "
"is selected)."
msgstr ""

#: ../../../source/USER_GUIDE.md:108
msgid ""
"**From / To**: Depth ranges for each interval (Mandatory if Interval "
"Layer is selected)."
msgstr ""

#: ../../../source/USER_GUIDE.md:109
msgid ""
"**Lithology**: Field containing the rock type or attribute to visualize "
