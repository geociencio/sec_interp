msgid "3. Plugin Information Tab"
msgstr ""

#: ../../../source/USER_GUIDE.md:186
msgid "Displays version information, credits, and contact details for SecInterp."
msgstr ""

#: ../../../source/USER_GUIDE.md:188
msgid ""
"![Plugin Information](images/guide_settings_info.png) *Plugin "
"Information.*"
msgstr ""

#: ../../../source/USER_GUIDE.md:188
