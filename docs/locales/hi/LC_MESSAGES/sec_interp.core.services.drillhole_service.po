msgid "Drillhole Data Processing Service."
msgstr ""

#: of sec_interp.core.services.drillhole_service:3
msgid ""
"This module provides services for processing and projecting drillhole "
"data, including collar projection, trajectory calculation, and interval "
"interpolation."
msgstr ""

#: of sec_interp.core.services.drillhole_service.DrillholeService:1
msgid "Service for processing and orchestrating drillhole data."
msgstr ""

#: of sec_interp.core.services.drillhole_service.DrillholeService:3
msgid ""
"This service handles the projection of collars onto a 2D section line, "
"the calculation of 3D trajectories from survey data, and the "
"interpolation of geological intervals along those trajectories. It "
"leverages specialized processors to maintain a clean separation of "
"concerns."
msgstr ""

