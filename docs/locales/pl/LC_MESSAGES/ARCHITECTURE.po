msgid "Main Features"
msgstr ""

#: ../../../source/ARCHITECTURE.md:32
msgid "✅ **Interactive Preview System** with real-time rendering"
msgstr ""

#: ../../../source/ARCHITECTURE.md:33
msgid "✅ **Parallel Processing** for complex geological intersections"
msgstr ""

#: ../../../source/ARCHITECTURE.md:34
msgid "✅ **Adaptive LOD** (Level of Detail) based on zoom"
msgstr ""

#: ../../../source/ARCHITECTURE.md:35
msgid "✅ **Measurement Tools** with automatic snapping"
msgstr ""

#: ../../../source/ARCHITECTURE.md:36
