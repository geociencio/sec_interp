msgid ""
"**Linting QGIS Security Scan**: 85 issues reportados (F821 imports "
"faltantes, W503 line breaks). No afectan funcionalidad pero ensucian el "
"reporte."
msgstr ""

#: ../../../source/phase_closure_v3.0.0.md:45
msgid ""
"**Legacy Imports**: Uso de `PyQt5` directo en lugar de `qgis.PyQt` "
"(bloqueante para QGIS 4.x)."
msgstr ""

#: ../../../source/phase_closure_v3.0.0.md:47
msgid "🟢 Menor (Backlog)"
msgstr ""

#: ../../../source/phase_closure_v3.0.0.md:48
msgid ""
"**Recursos**: `resources.py` necesita actualización para ser agnóstico de"
" API."
msgstr ""

#: ../../../source/phase_closure_v3.0.0.md:49
msgid ""
"**Logging**: Archivos de log rotados no se limpian automáticamente en "
"entorno local (solucionado en paquete de distribución)."
msgstr ""

